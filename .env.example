# Set through Discloud's private secrets. Never commit real values.
JARVIS_VOICE_TOKEN=generate-a-random-unique-secret-of-at-least-32-characters
JARVIS_VOICE_HOST=0.0.0.0
JARVIS_VOICE_PORT=8777
JARVIS_KOKORO_VOICE=bm_george
JARVIS_VOICE_SPEED=0.94
JARVIS_VOICE_CPU_THREADS=2
# Set only after measuring actual peak RSS. 0 disables application-level guard.
JARVIS_VOICE_MAX_RSS_MB=0
# Premium paid provider is OFF by default. Must also be explicitly requested.
JARVIS_CARTESIA_ENABLED=false
CARTESIA_API_KEY=
